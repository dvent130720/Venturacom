# ──────────────────────────────────────────────
# Base de datos (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://venturacom:venturacom_pass@localhost:5432/venturacom_sri"
DB_USER=venturacom
DB_PASSWORD=venturacom_pass
DB_NAME=venturacom_sri

# ──────────────────────────────────────────────
# Redis (BullMQ)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Clave de API para autenticación de las peticiones (genera con: openssl rand -hex 32)
API_KEY=your_api_key_here

# ──────────────────────────────────────────────
# Cifrado de certificados (AES-256-GCM)
# Genera con: openssl rand -hex 32
# ──────────────────────────────────────────────
ENCRYPTION_KEY=your_32_byte_hex_key_here

# ──────────────────────────────────────────────
# SRI Ecuador
# ──────────────────────────────────────────────
# 1 = Pruebas | 2 = Producción
SRI_ENVIRONMENT=1

# Endpoints SRI Pruebas
SRI_RECEPTION_URL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline
SRI_AUTHORIZATION_URL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline

# Reintentos del worker
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=30000

# ──────────────────────────────────────────────
# Datos del emisor por defecto
# ──────────────────────────────────────────────
ISSUER_RUC=1234567890001
ISSUER_BUSINESS_NAME=EMPRESA EMISORA S.A.
ISSUER_TRADE_NAME=EMPRESA EMISORA
ISSUER_ADDRESS=AV. PRINCIPAL 123
ISSUER_ESTABLISHMENT=001
ISSUER_EMISSION_POINT=001
