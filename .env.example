# ──────────────────────────────────────────────
# Base de datos PostgreSQL
# ──────────────────────────────────────────────
DB_USER=venturacom
DB_PASSWORD=venturacom_pass
DB_NAME=venturacom_sri

# ──────────────────────────────────────────────
# API — autenticación por header X-API-Key
# Genera: openssl rand -hex 32
# ──────────────────────────────────────────────
API_KEY=your_api_key_here

# ──────────────────────────────────────────────
# Cifrado AES-256-GCM de certificados P12
# Genera: openssl rand -hex 32  (producirá 64 chars hex = 32 bytes)
# ──────────────────────────────────────────────
ENCRYPTION_KEY=your_64_hex_char_aes256_key_here

# ──────────────────────────────────────────────
# Datos del emisor (empresa que emite las facturas)
# ──────────────────────────────────────────────
ISSUER_RUC=1234567890001
ISSUER_BUSINESS_NAME=EMPRESA EMISORA S.A.
ISSUER_TRADE_NAME=EMPRESA EMISORA
ISSUER_ADDRESS=AV. PRINCIPAL 123 Y SECUNDARIA
ISSUER_ESTABLISHMENT=001
ISSUER_EMISSION_POINT=001
