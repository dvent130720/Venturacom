# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_USER=venturacom
DB_PASSWORD=venturacom_pass
DB_NAME=venturacom_sri

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_pass

# ── API interna (X-API-Key) ───────────────────────────────────────────────────
# Genera: openssl rand -hex 16
API_KEY=your_api_key_here

# ── Cifrado AES-256-GCM de certificados P12 ───────────────────────────────────
# Genera: openssl rand -hex 32  (64 chars hex = 32 bytes)
ENCRYPTION_KEY=your_64_hex_char_aes256_key_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_chars

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Crea credenciales en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── SMTP (envío de OTP por correo) ────────────────────────────────────────────
# Gmail: usa una App Password (no tu contraseña principal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu_app_password

# ── Frontend URL (para CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── Emisor SRI Ecuador ────────────────────────────────────────────────────────
ISSUER_RUC=1234567890001
ISSUER_BUSINESS_NAME=EMPRESA EMISORA S.A.
ISSUER_TRADE_NAME=EMPRESA EMISORA
ISSUER_ADDRESS=AV. PRINCIPAL 123 Y SECUNDARIA
ISSUER_ESTABLISHMENT=001
ISSUER_EMISSION_POINT=001
